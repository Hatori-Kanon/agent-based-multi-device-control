  "cards": [
    {
      "dot": "cyan",
      "title": "运行形态：四个进程",
      "items": [
        "桌面壳用 pywebview 拉起 bun 中继(:9998) 与 Python 后端(:8000)，关窗按进程树清理子进程",
        "FastAPI 直接托管前端 dist，桌面窗口与浏览器打开的是同一个控制台网页",
        "dry_run 默认 true：没有配对设备时动作只做校验与记录，不发送真实帧"
      ]
    },
    {
      "dot": "rose",
      "title": "安全层：五道闸",
      "items": [
        "每通道硬上限 + 运行时上限（默认 100，页面可调到 200），AI 与手动命令同一出口",
        "单条增减 ≤ max_strength_step(40)；临时强度 ≤ max_temp_duration_s(10s) 到点归零",
        "过热时该通道上限临时降到 20；App/中继断开自动清零",
        "急停 = 全通道清零 + 清波形 + 暂停 AI 循环；estop 期间拒绝一切动作"
      ]
    },
    {
      "dot": "emerald",
      "title": "上行状态：App 是状态源",
      "items": [
        "被控方上报 devices.snapshot / slots.patch（含 comfortLimit、slotState）/ custom.action",
        "RelayClient 事件回调 → AppState → SafetyManager.update_device_state 采纳 App 舒适上限",
        "首次配对成功后缓 3 秒，AI 主动开场并给出第一个轻微动作"
      ]
    },
    {
      "dot": "violet",
      "title": "内容与设备通道",
      "items": [
        "角色 = 提示词 + 语料 + 设定三件套（content/pure），换角色不改代码",
        "DLC 以 zip 导入 content/pack/ 并回写 character.yaml，热加载生效",
        "device_channels.yaml 把 A/B 通道绑定到具体配件与强度基准，提示词据此描写"
      ]
    }
  ]
}
