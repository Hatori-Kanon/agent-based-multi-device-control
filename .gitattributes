# Normalize all text files to LF in the repository.
* text=auto eol=lf

# Windows-only scripts must keep CRLF in the working tree.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.vcxproj text eol=crlf

# Binary assets: never attempt text conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.pdf binary
*.exe binary
*.dll binary
*.node binary
